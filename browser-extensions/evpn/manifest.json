{
  "manifest_version": 3,
  "name": "eVPN Status",
  "version": "1.7.0",
  "description": "VPN connection status and network info",
  "permissions": [
    "storage",
    "proxy"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "eVPN Status",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "102"
}